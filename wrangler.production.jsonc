{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aervyntai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aervyntai"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://aervynt.ai",
    "LEAD_PROVIDER": "hubspot",
    "HUBSPOT_PORTAL_ID": "247218560",
    "HUBSPOT_FORM_ID": "658e0c50-acd7-42d2-b0dd-52917cd88852",
    "HUBSPOT_FIELD_MAP": "{\"email\":\"email\",\"enquiry\":\"message\"}",
    "LEAD_RATE_LIMIT_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "247218560",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
